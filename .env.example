# Nahva — local environment template
# Copy to .env and fill in. Never commit .env (see .gitignore).

# ── intervals.icu ──
# API key from intervals.icu → Settings → Developer.
# Auth is HTTP Basic: username literally "API_KEY", password = the key.
INTERVALS_API_KEY=
INTERVALS_ATHLETE_ID=

# ── Supabase ──
SUPABASE_URL=https://<project-ref>.supabase.co

# Client-safe. Used by the front-end (/web) and set as a Vercel env var.
SUPABASE_PUBLISHABLE_KEY=

# Server-side only. Bypasses RLS. Used by the pipeline + GitHub Action.
SUPABASE_SECRET_KEY=

# SESSION POOLER connection string — not the direct db.<ref>.supabase.co host.
# The direct host is IPv6-only and unreachable from GitHub Actions (BUILD_BRIEF §6).
# Format: postgresql://postgres.<ref>:<password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=

# ── Coaching connector (Step 8) ──
# Read-only role used by the Claude Supabase connector. SELECT only.
SUPABASE_READONLY_DB_URL=
